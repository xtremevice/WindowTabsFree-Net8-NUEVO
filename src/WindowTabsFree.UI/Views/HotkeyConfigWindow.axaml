<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="400" d:DesignHeight="300"
        x:Class="WindowTabsFree.UI.Views.HotkeyConfigWindow"
        Title="Hotkey Configuration"
        Width="400" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Title -->
        <TextBlock Grid.Row="0" 
                   Text="Configure Hotkeys" 
                   FontSize="16" 
                   FontWeight="Bold"
                   Margin="0,0,0,20"/>
        
        <!-- Next Window Hotkey -->
        <Grid Grid.Row="1" ColumnDefinitions="150,*" Margin="0,0,0,15">
            <TextBlock Grid.Column="0" 
                       Text="Next Window:" 
                       VerticalAlignment="Center"
                       FontSize="12"/>
            <TextBox Grid.Column="1" 
                     Name="NextWindowTextBox"
                     Watermark="e.g., Ctrl+Tab"
                     FontSize="12"
                     Padding="8,6"/>
        </Grid>
        
        <!-- Previous Window Hotkey -->
        <Grid Grid.Row="2" ColumnDefinitions="150,*" Margin="0,0,0,15">
            <TextBlock Grid.Column="0" 
                       Text="Previous Window:" 
                       VerticalAlignment="Center"
                       FontSize="12"/>
            <TextBox Grid.Column="1" 
                     Name="PreviousWindowTextBox"
                     Watermark="e.g., Ctrl+Shift+Tab"
                     FontSize="12"
                     Padding="8,6"/>
        </Grid>
        
        <!-- Help Text -->
        <Border Grid.Row="3" 
                BorderBrush="LightGray" 
                BorderThickness="1" 
                Padding="10" 
                Margin="0,0,0,15"
                Background="#F5F5F5">
            <StackPanel>
                <TextBlock Text="Hotkey Format Examples:" 
                          FontSize="11" 
                          FontWeight="Bold" 
                          Margin="0,0,0,5"/>
                <TextBlock Text="• Ctrl+Tab" FontSize="10" Margin="5,2"/>
                <TextBlock Text="• Ctrl+Shift+Tab" FontSize="10" Margin="5,2"/>
                <TextBlock Text="• Alt+Right" FontSize="10" Margin="5,2"/>
                <TextBlock Text="• Ctrl+Alt+N" FontSize="10" Margin="5,2"/>
            </StackPanel>
        </Border>
        
        <!-- Spacer -->
        <Panel Grid.Row="4"/>
        
        <!-- Buttons -->
        <StackPanel Grid.Row="5" 
                    Orientation="Horizontal" 
                    HorizontalAlignment="Right"
                    Spacing="10">
            <Button Content="Save" 
                    Click="SaveButton_Click"
                    Width="80"
                    Height="32"
                    Background="#4CAF50"
                    Foreground="White"/>
            <Button Content="Cancel" 
                    Click="CancelButton_Click"
                    Width="80"
                    Height="32"/>
        </StackPanel>
    </Grid>
</Window>
