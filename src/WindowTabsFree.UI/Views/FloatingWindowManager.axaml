<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="using:WindowTabsFree.Common.Models"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="400"
        x:Class="WindowTabsFree.UI.Views.FloatingWindowManager"
        Title="Window Manager (Floating)"
        Width="300" Height="400"
        Topmost="True"
        CanResize="True"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header with Pin On Top Toggle -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,5">
            <TextBlock Grid.Column="0" 
                       Text="Windows" 
                       FontSize="12" 
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>
            <ToggleButton Grid.Column="1" 
                         Name="PinOnTopToggle"
                         Content="📌" 
                         Click="PinOnTopToggle_Click"
                         IsChecked="True"
                         Padding="4,2"
                         FontSize="10"/>
        </Grid>
        
        <!-- Simplified Windows List - Just Buttons with Titles -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <ItemsControl Name="GroupsItemsControl">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="models:TabGroup">
                        <StackPanel Margin="0,2">
                            <!-- Simple buttons for each window showing only title -->
                            <ItemsControl ItemsSource="{Binding WindowsInfo}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="models:WindowInfo">
                                        <StackPanel>
                                            <!-- Active window button (green) -->
                                            <Button Click="FocusThisTab_Click"
                                                   Tag="{Binding}"
                                                   HorizontalAlignment="Stretch"
                                                   HorizontalContentAlignment="Left"
                                                   Margin="0,2"
                                                   Padding="8,6"
                                                   Height="35"
                                                   Background="#C8E6C9"
                                                   IsVisible="{Binding IsActiveInGroup}">
                                                <TextBlock Text="{Binding DisplayTitle}" 
                                                          FontSize="11" 
                                                          TextWrapping="NoWrap"
                                                          TextTrimming="CharacterEllipsis"
                                                          FontWeight="Bold"/>
                                            </Button>
                                            <!-- Inactive window button (white) -->
                                            <Button Click="FocusThisTab_Click"
                                                   Tag="{Binding}"
                                                   HorizontalAlignment="Stretch"
                                                   HorizontalContentAlignment="Left"
                                                   Margin="0,2"
                                                   Padding="8,6"
                                                   Height="35"
                                                   Background="White"
                                                   IsVisible="{Binding IsInactive}">
                                                <TextBlock Text="{Binding DisplayTitle}" 
                                                          FontSize="11" 
                                                          TextWrapping="NoWrap"
                                                          TextTrimming="CharacterEllipsis"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        
        <!-- Hotkey Configuration Button -->
        <Button Grid.Row="2" 
                Content="⚙️ Configure Hotkeys" 
                Click="ConfigureHotkeys_Click"
                HorizontalAlignment="Stretch"
                Margin="0,5,0,5"
                Padding="8,4"
                FontSize="10"
                Background="#E3F2FD"/>
        
        <!-- Close Button -->
        <Button Grid.Row="3" 
                Content="Close" 
                Click="CloseWindow_Click"
                HorizontalAlignment="Stretch"
                Padding="8,4"
                FontSize="10"
                Background="#FFCDD2"/>
    </Grid>
</Window>
