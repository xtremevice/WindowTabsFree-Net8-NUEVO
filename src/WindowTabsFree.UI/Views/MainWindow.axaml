<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WindowTabsFree.UI.ViewModels"
        xmlns:models="using:WindowTabsFree.Common.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="WindowTabsFree.UI.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="WindowTabsFree - Window Manager"
        Width="1000" Height="700">

    <Design.DataContext>
        <!-- This only sets the DataContext for the previewer in an IDE,
             to set the actual DataContext for runtime, set the DataContext property in code (look at App.axaml.cs) -->
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Toolbar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Spacing="10">
            <Button Content="🔄 Refresh Now" Click="RefreshButton_Click"/>
            <Button Content="📁 New Manual Group" Click="NewTabGroupButton_Click"/>
            <Button Content="🪟 Floating Window" Click="FloatingWindowButton_Click"/>
            <TextBlock Text="Auto-refresh every 2 seconds" VerticalAlignment="Center" 
                      Foreground="Gray" FontSize="12" Margin="10,0,0,0"/>
            <TextBlock Text="• Use checkboxes to auto-group apps individually" VerticalAlignment="Center" 
                      Foreground="Gray" FontSize="12" FontStyle="Italic" Margin="10,0,0,0"/>
        </StackPanel>

        <!-- Hotkey Configuration Section -->
        <Border Grid.Row="1" BorderBrush="LightBlue" BorderThickness="1" 
                Background="#F0F8FF" Padding="10" Margin="10,0,10,5">
            <Grid ColumnDefinitions="Auto,200,Auto,200,Auto">
                <TextBlock Grid.Column="0" Text="⌨️ Next Window:" 
                          VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"/>
                <TextBox Grid.Column="1" Name="NextWindowHotkeyTextBox"
                        Watermark="Click and press keys..."
                        FontSize="11" Padding="6,4" Margin="0,0,10,0"/>
                
                <TextBlock Grid.Column="2" Text="Previous Window:" 
                          VerticalAlignment="Center" FontSize="12" Margin="0,0,10,0"/>
                <TextBox Grid.Column="3" Name="PreviousWindowHotkeyTextBox"
                        Watermark="Click and press keys..."
                        FontSize="11" Padding="6,4" Margin="0,0,10,0"/>
                
                <Button Grid.Column="4" Content="💾 Save Hotkeys" 
                       Click="SaveHotkeysButton_Click"
                       Background="#4CAF50" Foreground="White"
                       Padding="10,5" FontSize="11"/>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="2" ColumnDefinitions="300,*" Margin="10">
            <!-- Left Panel - Tab Groups -->
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" 
                   Padding="10" Margin="0,0,10,0">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="Tab Groups" 
                              FontWeight="Bold" FontSize="16" Margin="0,0,0,10"/>
                    
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding TabGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:TabGroup">
                                    <Border BorderBrush="LightGray" BorderThickness="1" 
                                           Padding="10" Margin="0,5,0,5" 
                                           Background="{Binding Color, FallbackValue=White}">
                                        <StackPanel>
                                            <!-- Group Header -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="14"/>
                                                    <TextBlock Text="{Binding ApplicationName, StringFormat='App: {0}'}" 
                                                              FontSize="11" Foreground="Gray"
                                                              IsVisible="{Binding IsAutoGrouped}"/>
                                                    <TextBlock Text="{Binding WindowHandles.Count, StringFormat='Windows: {0}'}" 
                                                              FontSize="11" Foreground="Gray"/>
                                                </StackPanel>
                                                <Button Grid.Column="1" Content="×" Click="DeleteTabGroupButton_Click" 
                                                       Tag="{Binding}" FontSize="18" Width="30" Height="30"
                                                       Background="#FFCDD2"/>
                                            </Grid>
                                            
                                            <!-- Tab Navigation Buttons -->
                                            <StackPanel Orientation="Horizontal" Spacing="5" Margin="0,10,0,5">
                                                <Button Content="◄ Prev Tab" Click="PrevTabButton_Click" 
                                                       Tag="{Binding}" Width="85" FontSize="11"
                                                       IsEnabled="{Binding WindowHandles.Count}"/>
                                                <Button Content="Next Tab ►" Click="NextTabButton_Click" 
                                                       Tag="{Binding}" Width="85" FontSize="11"
                                                       IsEnabled="{Binding WindowHandles.Count}"/>
                                            </StackPanel>
                                            
                                            <!-- Active Tab Info -->
                                            <Border BorderBrush="#4CAF50" BorderThickness="2" 
                                                   Padding="5" Margin="0,5,0,0"
                                                   Background="#E8F5E9"
                                                   IsVisible="{Binding WindowHandles.Count}">
                                                <StackPanel>
                                                    <TextBlock Text="Active Tab:" FontSize="10" 
                                                              Foreground="Gray" FontWeight="Bold"/>
                                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                                        <TextBlock Text="Tab" FontSize="11"/>
                                                        <TextBlock Text="{Binding ActiveWindowIndex}" 
                                                                  FontSize="11" FontWeight="Bold"/>
                                                        <TextBlock Text="of" FontSize="11"/>
                                                        <TextBlock Text="{Binding WindowHandles.Count}" 
                                                                  FontSize="11" FontWeight="Bold"/>
                                                    </StackPanel>
                                                </StackPanel>
                                            </Border>
                                            
                                            <!-- Tabs/Windows in Group -->
                                            <Border BorderBrush="LightGray" BorderThickness="1" 
                                                   Padding="5" Margin="0,10,0,0"
                                                   Background="#FAFAFA"
                                                   IsVisible="{Binding WindowsInfo.Count}">
                                                <StackPanel>
                                                    <TextBlock Text="Tabs:" FontSize="10" 
                                                              Foreground="Gray" FontWeight="Bold" 
                                                              Margin="0,0,0,5"/>
                                                    <ItemsControl ItemsSource="{Binding WindowsInfo}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate DataType="models:WindowInfo">
                                                                <StackPanel>
                                                                    <!-- Active Tab (Green highlight) -->
                                                                    <Border BorderBrush="#4CAF50" 
                                                                           BorderThickness="3" 
                                                                           Padding="8" 
                                                                           Margin="0,3,0,3"
                                                                           CornerRadius="4"
                                                                           Background="#C8E6C9"
                                                                           IsVisible="{Binding IsActiveInGroup}">
                                                                        <StackPanel>
                                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                <TextBlock Text="✓" FontSize="14" Foreground="#2E7D32"/>
                                                                                <TextBlock Text="{Binding DisplayTitle}" 
                                                                                          FontSize="11" 
                                                                                          FontWeight="Bold"
                                                                                          TextWrapping="Wrap"
                                                                                          MaxWidth="200"/>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding ProcessName, StringFormat='App: {0}'}" 
                                                                                      FontSize="9" 
                                                                                      Foreground="Gray"
                                                                                      Margin="20,2,0,0"/>
                                                                            <TextBlock Text="[ACTIVE TAB]" 
                                                                                      FontSize="9" 
                                                                                      FontWeight="Bold"
                                                                                      Foreground="#2E7D32"
                                                                                      Margin="20,2,0,5"/>
                                                                            <Button Content="Focus This Tab" 
                                                                                   Click="FocusTabButton_Click"
                                                                                   Tag="{Binding}"
                                                                                   FontSize="10"
                                                                                   Height="24"
                                                                                   Margin="20,0,0,0"
                                                                                   Background="#81C784"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                    
                                                                    <!-- Inactive Tab (Blue/White) -->
                                                                    <Border BorderBrush="#2196F3" 
                                                                           BorderThickness="2" 
                                                                           Padding="8" 
                                                                           Margin="0,3,0,3"
                                                                           CornerRadius="4"
                                                                           Background="White"
                                                                           IsVisible="{Binding !IsActiveInGroup}">
                                                                        <StackPanel>
                                                                            <StackPanel Orientation="Horizontal" Spacing="5">
                                                                                <TextBlock Text="📄" FontSize="14"/>
                                                                                <TextBlock Text="{Binding DisplayTitle}" 
                                                                                          FontSize="11" 
                                                                                          TextWrapping="Wrap"
                                                                                          MaxWidth="200"/>
                                                                            </StackPanel>
                                                                            <TextBlock Text="{Binding ProcessName, StringFormat='App: {0}'}" 
                                                                                      FontSize="9" 
                                                                                      Foreground="Gray"
                                                                                      Margin="20,2,0,0"/>
                                                                            <Button Content="Focus This Tab" 
                                                                                   Click="FocusTabButton_Click"
                                                                                   Tag="{Binding}"
                                                                                   FontSize="10"
                                                                                   Height="24"
                                                                                   Margin="20,5,0,0"
                                                                                   Background="#E3F2FD"/>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Right Panel - Windows List -->
            <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Padding="10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Active Windows" FontWeight="Bold" FontSize="16" 
                                  VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding Windows.Count, StringFormat=' ({0})'}" 
                                  FontSize="14" Foreground="Gray" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- Window List -->
                    <ScrollViewer>
                        <ItemsControl ItemsSource="{Binding Windows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="models:WindowInfo">
                                    <Border BorderBrush="LightGray" BorderThickness="1" 
                                           Padding="10" Margin="0,5,0,5" 
                                           Background="White">
                                        <StackPanel>
                                            <!-- Application Name Header -->
                                            <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,5">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="📱" FontSize="16"/>
                                                    <TextBlock Text="{Binding ProcessName}" 
                                                              FontWeight="Bold" FontSize="16" 
                                                              Foreground="#1976D2"/>
                                                    <TextBlock Text="{Binding ApplicationWindowCount, StringFormat='({0} windows)'}" 
                                                              FontSize="12" Foreground="Gray" 
                                                              VerticalAlignment="Center"/>
                                                </StackPanel>
                                                <!-- Auto-Group Checkbox -->
                                                <CheckBox Grid.Column="1" 
                                                         Content="Auto-group" 
                                                         IsChecked="{Binding IsAutoGroupEnabled}"
                                                         Tag="{Binding ProcessName}"
                                                         Click="ToggleAutoGroupCheckBox_Click"
                                                         FontSize="11"
                                                         FontWeight="Bold"
                                                         ToolTip.Tip="Check to automatically group all windows of this app together (requires 2+ windows)"/>
                                            </Grid>
                                            
                                            <!-- Window Title -->
                                            <TextBlock Text="{Binding DisplayTitle}" 
                                                      FontSize="14" 
                                                      Foreground="#424242"
                                                      Margin="0,0,0,5"
                                                      TextWrapping="Wrap"/>
                                            
                                            <!-- Window Details -->
                                            <Grid ColumnDefinitions="*,*">
                                                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="Size:" FontSize="11" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding Bounds.Width}" 
                                                              FontSize="11" Foreground="Gray"/>
                                                    <TextBlock Text="×" FontSize="11" Foreground="Gray"/>
                                                    <TextBlock Text="{Binding Bounds.Height}" 
                                                              FontSize="11" Foreground="Gray"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="5">
                                                    <TextBlock Text="State:" FontSize="11" Foreground="Gray"/>
                                                    <TextBlock Text="Minimized" FontSize="11" 
                                                              Foreground="Orange" 
                                                              IsVisible="{Binding IsMinimized}"/>
                                                    <TextBlock Text="Maximized" FontSize="11" 
                                                              Foreground="Green" 
                                                              IsVisible="{Binding IsMaximized}"/>
                                                    <TextBlock Text="Normal" FontSize="11" 
                                                              Foreground="Blue"
                                                              IsVisible="{Binding !IsMinimized}"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Action Buttons -->
                                            <StackPanel Orientation="Horizontal" 
                                                       Spacing="5" 
                                                       Margin="0,10,0,0">
                                                <Button Content="Focus" 
                                                       Tag="{Binding}" 
                                                       Click="FocusButton_Click"
                                                       Width="70"
                                                       Height="28"/>
                                                <Button Content="Minimize" 
                                                       Tag="{Binding}" 
                                                       Click="MinimizeButton_Click"
                                                       Width="70"
                                                       Height="28"/>
                                                <Button Content="Maximize" 
                                                       Tag="{Binding}" 
                                                       Click="MaximizeButton_Click"
                                                       Width="70"
                                                       Height="28"/>
                                                <Button Content="Restore" 
                                                       Tag="{Binding}" 
                                                       Click="RestoreButton_Click"
                                                       Width="70"
                                                       Height="28"/>
                                                <Button Content="Close" 
                                                       Tag="{Binding}" 
                                                       Click="CloseButton_Click"
                                                       Width="70"
                                                       Height="28"
                                                       Background="#FFCDD2"/>
                                                <Button Content="➕ Add to Group" 
                                                       Tag="{Binding}" 
                                                       Click="AddToGroupButton_Click"
                                                       Width="120"
                                                       Height="28"
                                                       Background="#C8E6C9"
                                                       FontWeight="Bold"
                                                       IsEnabled="{Binding $parent[Window].DataContext.CanAddToGroup}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>

</Window>
